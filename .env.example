# Environment Configuration for LazyOps AI
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Ollama ──────────────────────────────────────────────────────────────────
# Base URL for your local Ollama instance
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model to use for analysis (must be pulled first: ollama pull <model>)
# Recommended models that support JSON output:
#   llama3.2        (lightweight, good for most tasks)
#   mistral         (good instruction following)
#   qwen2.5         (strong structured output)
#   phi3            (very lightweight, lower RAM)
OLLAMA_MODEL=llama3.2

# Request timeout for Ollama in seconds
OLLAMA_TIMEOUT=120

# ─── Application ─────────────────────────────────────────────────────────────
# Directory for all application data (uploads, database)
APP_DATA_DIR=./data

# SQLite database URL (relative to backend working directory)
DATABASE_URL=sqlite:///./data/lazyops.db

# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=10

# Maximum extracted text to send to the AI model (characters)
MAX_EXTRACTED_TEXT_CHARS=8000

# ─── API Server ──────────────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend host and port
API_HOST=127.0.0.1
API_PORT=8000

# ─── Logging ─────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─── Security ────────────────────────────────────────────────────────────────
# Secret key for future token signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# Not required for pure local use but good practice to set
SECRET_KEY=change-this-to-a-random-secret-key

# ─── Demo Mode ───────────────────────────────────────────────────────────────
# Set to true to allow loading demo documents from demo/
DEMO_MODE=false

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
